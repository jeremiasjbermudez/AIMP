# This install's real URLs, keys and paths.
install/install.env

# Generated at install time from the modules that were installed.
admin/src/modules.generated.tsx

# Download logs from fetch-assets, started by install-module.
install/logs/

# Module panels. The source of each is admin-src/; install-module.ps1 copies it
# into admin/src when the module is installed. A clean checkout has none of them,
# which is what keeps the app bare until modules are chosen.
