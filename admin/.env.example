# Copy to pipeline-admin-next/.env and fill in.
# Flow ids are per-install: create the flows (see flowise/README.md), then paste each id here.

VITE_INSFORGE_URL=http://localhost:7130
VITE_INSFORGE_ANON_KEY=

# Fixed local account this single-operator admin tool signs in as
# automatically, so storage RLS (which only ships base grants for
# `authenticated`, not `anon`) allows uploads. See migration
# 20260816184107_fix-storage-rls-use-authenticated.sql.
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=

# 2-Trigger-Orchestration: Beat/Character-List/Scene-List resolve -> for each
# character, Character-Generator -> for each scene, Panoramic-Generator ->
# World-Builder. Deliberately stops there - everything after World-Builder
# (shot list, camera placement, image cleanup, places everyone, inpaint,
# per-shot generation) belonged to the abandoned fully-automated camera/shot
# pipeline and is now the manual ShotsPanel flow instead (see VITE_GS_CLEANER_ID
# / VITE_MINIMAX_CLIP_GENERATOR_ID below). The admin UI's "Run" button POSTs
# {question: beat_code} here.
VITE_FLOWISE_URL=http://localhost:3010
VITE_FLOWISE_API_KEY=
VITE_TRIGGER_ORCHESTRATOR_ID=

# ComfyUI's own /view endpoint - character_images and shots.cleaned_image_path
# are ComfyUI-local paths, not InsForge storage URLs.
VITE_COMFY_URL=http://127.0.0.1:8188

# ShotsPanel: 6-GS-Cleaner and 7-MiniMax-Clip-Generator, invoked directly
# rather than through 2-Trigger-Orchestration (which stops at World-Builder).
VITE_GS_CLEANER_ID=
VITE_MINIMAX_CLIP_GENERATOR_ID=

VITE_MINIMAX_I2V_ID=
VITE_MINIMAX_T2V_ID=
VITE_QWEN_CLEANUP_ID=
VITE_PROMPT_ENHANCER_ID=
VITE_CHARACTER_GENERATOR_ID=
VITE_CHARACTER_BIBLE_IMPORT_ID=
VITE_SCREENPLAY_ASSIST_ID=
VITE_SCENE_IMPORT_ID=
VITE_DELETE_MOVIE_ID=
VITE_PANORAMIC_GENERATOR_ID=
VITE_WORLD_BUILDER_ID=
VITE_MINIMAX_EXTEND_ID=
VITE_MINIMAX_REF_ID=
VITE_POST_VOICE_ID=
VITE_SCORE_ID=
VITE_RESOLVE_ID=
VITE_RESOLVE_CHAT_ID=

# 17-Screenplay-Writer: chat that turns an idea into a full screenplay in the
# format the breakdown parses. 18-Character-Bible-Writer: chat that reads the
# screenplay and current cast and rewrites the character bible.
VITE_SCREENPLAY_WRITER_ID=
VITE_CHARACTER_BIBLE_WRITER_ID=

# 24-Face-QA: scores a clip's face against a character's references.
VITE_FACE_QA_ID=

# 25-Character-QA-Shots: one photo -> the reference angles face QA needs.
VITE_CHARACTER_QA_SHOTS_ID=

# 26-Image-Edit: FLUX.2 Klein editing with multiple reference images.
VITE_IMAGE_EDIT_ID=

# 27-Pano-Prompt-From-Image: qwen3.8 vision looks at a project image and writes
# a 360 panorama prompt for that place.
VITE_PANO_PROMPT_ID=

# 28-Qwen-Image-Edit: Qwen-Rapid-AIO edits, the second engine on the Image
# Edit tab. References go straight to the text encoder (image1..image3), so it
# takes three at most.
VITE_QWEN_IMAGE_EDIT_ID=

# 29-Delete-Asset: removes a rendered file from ComfyUI output/input when
# its row is deleted. Refuses paths outside those folders, and keeps any file
# another row still references.
VITE_DELETE_ASSET_ID=

# 30-Score-Agent: reads a beat and proposes contrasting cues from the
# score_styles taxonomy. Returns proposals only - nothing is rendered.
VITE_SCORE_AGENT_ID=

# 31-Palette-Namer: names a colour palette and writes its grading note.
# Swatches are measured in the browser; this only supplies the words.
VITE_PALETTE_NAMER_ID=

# 32-Apply-LUT: grades a rendered clip with a palette via ffmpeg lut3d.
# Same tint maths as the browser preview, so stills and clips agree.
VITE_APPLY_LUT_ID=

# 34-Face-Fix: masked face repaint on a still, from Face QA.
VITE_FACE_FIX_ID=

# 35-MiniMax-Video-to-Video: restyle or re-cast an existing clip.
VITE_MINIMAX_V2V_ID=

# 36-Z-Image: Z-Image Turbo, generation only (no reference editing until the
# Omni/Edit weights are released). LoRAs supported.
VITE_Z_IMAGE_ID=

# 37-Prompt-World: a 3D world from a prompt alone, no scene required.
VITE_PROMPT_WORLD_ID=

# 38-HY-World: HY-World 2.0 - text, image or video in, a 3DGS world out.
VITE_HYWORLD_ID=

VITE_DIRECTOR_ID=

# 40-Character-Wardrobe: renders a character reference sheet wearing a costume.
VITE_CHARACTER_WARDROBE_ID=

VITE_COPY_MOVIE_ID=

VITE_SHOT_BREAKDOWN_ID=

VITE_IMPORT_BREAKDOWN_ID=

VITE_IMAGE_CHECK_ID=

# 45-Splat-Camera: survey a scene's splat, name its landmarks, place the
# shot cameras in it and render their plates. Wraps _splat_camera.py.
VITE_SPLAT_CAMERA_ID=

# 46-MiniMax-Control-To-Video: a depth / pose / edge video (a Blender render
# over the scene's splat or mesh, typically) drives a MiniMax H3 shot through
# the Fun ControlNet Union. Same model as every other MiniMax tab.
VITE_MINIMAX_CONTROL_ID=
